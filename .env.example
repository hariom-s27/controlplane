# Copy this file to `.env` and fill it in.  `.env` is gitignored — never commit it.

# --- Featherless (LLM inference, OpenAI-compatible) --------------------------
FEATHERLESS_API_KEY=fw_your_key_here
# Optional — a second account's key. agents/llm.py tries FEATHERLESS_API_KEY
# first and falls back to _2 (then _3, ...) on 401/402/403/429, so one
# account running out of credit doesn't stop the pipeline.
# FEATHERLESS_API_KEY_2=
CP_BASE_URL=https://api.featherless.ai/v1

# Pin ONE model and do not change it mid-build.
# Native tool calling on Featherless works on the Qwen 3 family and Kimi-K2 only.
# Run `python scripts/probe.py` to confirm before you rely on it.
CP_MODEL=Qwen/Qwen3-8B
# CP_MODEL=Qwen/Qwen3-14B
# CP_MODEL=moonshotai/Kimi-K2-Instruct

# --- Firecrawl (one-off policy corpus scrape, S1) ---------------------------
# Optional. The scrape is cached to data/seed/policies_raw.json and committed,
# so the repo builds with no key after the first run.
FIRECRAWL_API_KEY=
# Optional — a second account's key, same fallback mechanism as above.
# FIRECRAWL_API_KEY_2=
CP_USE_FIRECRAWL=0

# --- determinism ------------------------------------------------------------
# One seed for the whole project. Same number SEB-1 uses.
CP_SEED=20260814

# The demo clock is FROZEN on purpose. With the real system date, "26 days
# elapsed" becomes 27, then 28, and the recorded video goes stale in a week.
CP_DEMO_DATE=2026-08-14

# --- feature flags ----------------------------------------------------------
CP_GATE=on            # on | off   — `off` is the negative control
CP_MANIFEST=servicing # servicing | knowledge_assistant
CP_GROUNDING=off      # on pulls a ~500MB model; the demo runs fine without it
CP_PII=regex          # regex | presidio
CP_MODE=fixture       # fixture | live  — fixture replays committed LLM responses

# --- receipts (S10) ----------------------------------------------------------
# HMAC-SHA256 key for signing decision receipts. Generate your own with
# `python -c "import secrets; print(secrets.token_hex(32))"` — a real deploy
# would pull this from a secret manager, not .env.
CP_RECEIPT_SECRET=
