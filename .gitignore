# --- secrets. never commit. -------------------------------------------------
.env
*.key

# --- generated. rebuildable from committed seeds. ---------------------------
data/*.db
data/*.db-journal
data/stale_index/
reports/
decisions.jsonl
decisions_privileged.jsonl

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.hypothesis/
*.egg-info/

# --- editors / os -----------------------------------------------------------
.vscode/settings.json
.vscode/mcp.json
.DS_Store
Thumbs.db

# --- local tooling, not part of this project ---------------------------------
.argent/
.claude/
.mcp.json
node_modules/
package.json
package-lock.json

# --- big binaries: link them, don't commit them -----------------------------
*.mp4
*.mov
