data/*.db
data/*.db-journal
data/stale_index/
reports/
decisions.jsonl
decisions_privileged.jsonl

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.hypothesis/
*.egg-info/

# --- editors / os -----------------------------------------------------------
.vscode/settings.json
.DS_Store
Thumbs.db

# --- big binaries: link them, don't commit them -----------------------------
*.mp4
*.mov
